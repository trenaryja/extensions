{
  "name": "trenary",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "new:vscode-extension": "tsx ./scripts/new-vscode-extension.ts",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.4.0",
    "@types/node": "^22.13.11",
    "prettier": "^3.5.3",
    "remeda": "^2.21.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "semi": false,
    "printWidth": 120
  },
  "packageManager": "pnpm@10.6.3"
}
