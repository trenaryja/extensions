{
	"name": "trenary",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write . \"!bun.lock\"",
		"check-up": "bun run format && bun run lint && bun run build",
		"get-latest": "bun update --latest",
		"new:vscode-extension": "tsx ./scripts/new-vscode-extension.ts",
		"turbox": "bun packages/scripts/turbox.ts"
	},
	"devDependencies": {
		"@inquirer/prompts": "^8.1.0",
		"@types/node": "^25.0.3",
		"prettier": "^3.7.4",
		"remeda": "^2.32.0",
		"tsx": "^4.21.0",
		"turbo": "^2.7.2",
		"typescript": "5.9.3"
	},
	"prettier": {
		"singleQuote": true,
		"jsxSingleQuote": true,
		"semi": false,
		"printWidth": 120,
		"useTabs": true
	},
	"trustedDependencies": ["@vscode/vsce-sign", "esbuild", "keytar", "unrs-resolver"],
	"packageManager": "bun@1.3.11"
}
