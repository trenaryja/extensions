{
	"name": "extensions",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"fix": "prettier -w . '!apps' '!packages' && bunx eslint --fix . --ignore-pattern apps --ignore-pattern packages && turbo run fix",
		"check": "tsc && prettier -c . '!apps' '!packages' && bunx eslint . --max-warnings=0 --ignore-pattern apps --ignore-pattern packages && turbo run check",
		"format": "prettier -w .",
		"get-latest": "bun update --latest --interactive",
		"reinstall": "rm -rf node_modules bun.lock && bun install",
		"new:vscode-extension": "bun scripts/new-vscode-extension.ts"
	},
	"dependencies": {
		"prettier": "^3.9.8"
	},
	"devDependencies": {
		"@inquirer/prompts": "^8.7.2",
		"@trenaryja/config": "^0.0.8",
		"@types/node": "^26.6.2",
		"remeda": "^2.50.0",
		"turbo": "^2.11.2"
	},
	"prettier": "@trenaryja/config/prettier",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.0.0"
		}
	},
	"trustedDependencies": [
		"@raycast/api",
		"@vscode/vsce-sign",
		"esbuild",
		"keytar",
		"unrs-resolver"
	]
}
