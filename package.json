{
	"name": "trenary",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write . \"!pnpm-lock.yaml\"",
		"check-up": "pnpm run format && pnpm run lint && pnpm build",
		"get-latest": "pnpm up -L -i -r",
		"new:vscode-extension": "tsx ./scripts/new-vscode-extension.ts"
	},
	"devDependencies": {
		"@inquirer/prompts": "^8.1.0",
		"@types/node": "^25.0.3",
		"prettier": "^3.7.4",
		"remeda": "^2.32.0",
		"tsx": "^4.21.0",
		"turbo": "^2.7.2",
		"typescript": "5.9.3"
	},
	"prettier": {
		"singleQuote": true,
		"jsxSingleQuote": true,
		"semi": false,
		"printWidth": 120,
		"useTabs": true
	},
	"packageManager": "pnpm@10.24.0"
}
