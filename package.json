{
	"name": "vscode-extensions",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"fix": "prettier -w . && turbo run fix",
		"check": "tsc -b && prettier -c . && turbo run check",
		"lint": "turbo run lint",
		"format": "prettier -w .",
		"get-latest": "bun update --latest -i",
		"reinstall": "rm -rf node_modules && rm bun.lock && bun install",
		"new:vscode-extension": "tsx ./scripts/new-vscode-extension.ts"
	},
	"devDependencies": {
		"@inquirer/prompts": "^8.5.2",
		"@types/node": "^26.2.0",
		"prettier": "^3.9.6",
		"remeda": "^2.39.0",
		"tsx": "^4.23.12",
		"turbo": "^2.10.9",
		"typescript": "6.0.3"
	},
	"prettier": {
		"singleQuote": true,
		"jsxSingleQuote": true,
		"semi": false,
		"printWidth": 120,
		"useTabs": true
	},
	"trustedDependencies": [
		"@vscode/vsce-sign",
		"esbuild",
		"keytar",
		"unrs-resolver"
	],
	"packageManager": "bun@1.3.11"
}
