{
	"name": "extensions",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"chk": "tren chk && turbo run chk",
		"ci": "tren ci",
		"dev": "turbo run dev",
		"fix": "tren fix && turbo run fix",
		"format": "prettier -w .",
		"new:vscode-extension": "bun scripts/new-vscode-extension.ts"
	},
	"prettier": "@trenaryja/config/prettier",
	"dependencies": {
		"prettier": "^3.9.10"
	},
	"devDependencies": {
		"@inquirer/prompts": "^8.7.5",
		"@trenaryja/config": "^0.3.0",
		"@types/node": "^26.6.6",
		"remeda": "^2.57.0",
		"turbo": "^2.11.10",
		"zod": "^4.6.7"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.0.0"
		}
	},
	"trustedDependencies": [
		"@raycast/api",
		"@vscode/vsce-sign",
		"esbuild",
		"keytar",
		"unrs-resolver"
	]
}
