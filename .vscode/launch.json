{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ext: template-vscode-extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/template-vscode-extension"]
		},
		{
			"name": "Ext: Multi-Cursor Magic",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/multi-cursor-magic"]
		},
		{
			"name": "Ext: Marksmith",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/marksmith", "--disable-extensions"],
			"preLaunchTask": "build: marksmith"
		}
	]
}
