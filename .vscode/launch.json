{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Ext: MarkSlate",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"${workspaceFolder}/packages/markslate",
				"--extensionDevelopmentPath=${workspaceFolder}/packages/markslate",
				"--disable-extensions"
			],
			"preLaunchTask": "build: markslate"
		},
		{
			"name": "Ext: Multi-Cursor Magic",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/multi-cursor-magic"]
		},
		{
			"name": "Ext: template-vscode-extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/template-vscode-extension"]
		}
	]
}
