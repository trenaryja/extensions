{
	"name": "template-vscode-extension",
	"displayName": "Template VSCode Extension",
	"version": "0.0.1",
	"description": "Template VSCode Extension VSCode Extension",
	"publisher": "trenaryja",
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"scripts": {
		"build": "bun ./scripts/build.ts",
		"chk": "tsc && prettier -c . && bunx eslint . --max-warnings=0",
		"dev": "bun ./scripts/build.ts --watch",
		"fix": "prettier -w . && bunx eslint --fix ."
	},
	"contributes": {
		"commands": [
			{
				"command": "extension.helloWorld",
				"title": "Hello World"
			}
		]
	},
	"activationEvents": [],
	"devDependencies": {
		"@repo/vscode-utils": "workspace:*",
		"@types/vscode": "^1.107.0"
	},
	"engines": {
		"vscode": "^1.107.0"
	}
}
