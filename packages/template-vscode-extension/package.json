{
	"name": "template-vscode-extension",
	"displayName": "Template VSCode Extension",
	"description": "Template VSCode Extension VSCode Extension",
	"version": "0.0.1",
	"publisher": "trenaryja",
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"scripts": {
		"build": "bunx tsx ./scripts/build.ts",
		"dev": "bunx tsx ./scripts/build.ts --watch",
		"fix": "prettier -w .",
		"check": "tsc && bun run build",
		"vscode:prepublish": "bun run build"
	},
	"devDependencies": {
		"@repo/vscode-utils": "workspace:*",
		"@trenaryja/config": "^0.0.3",
		"@types/vscode": "^1.107.0",
		"bun-types": "^1.3.14",
		"esbuild": "^0.27.0",
		"tsx": "^4.22.4"
	},
	"activationEvents": [],
	"contributes": {
		"commands": [
			{
				"command": "extension.helloWorld",
				"title": "Hello World"
			}
		]
	},
	"engines": {
		"vscode": "^1.107.0"
	}
}
