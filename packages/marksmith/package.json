{
	"name": "marksmith",
	"displayName": "Marksmith",
	"description": "A beautiful live-preview markdown editor for VS Code — write without ever leaving your editor.",
	"version": "0.0.1",
	"publisher": "trenaryja",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/trenaryja/vscode-extensions.git",
		"directory": "packages/marksmith"
	},
	"bugs": {
		"url": "https://github.com/trenaryja/vscode-extensions/issues"
	},
	"homepage": "https://github.com/trenaryja/vscode-extensions/tree/main/packages/marksmith",
	"icon": "assets/icon.png",
	"galleryBanner": {
		"color": "#16130f",
		"theme": "dark"
	},
	"changelog": true,
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"scripts": {
		"build": "bunx tsx ./scripts/build.ts",
		"dev": "bunx tsx ./scripts/build.ts --watch",
		"contribute": "bun ./scripts/contribute.ts",
		"contribute:check": "bun ./scripts/contribute.ts --check",
		"harness": "bun run harness/screenshot.ts",
		"fix": "bun run contribute && prettier -w .",
		"check": "bun run contribute:check && tsc && prettier -c . && bun run build",
		"test": "bun test",
		"vsce:login": "vsce login trenaryja",
		"vsce:package": "vsce package --no-dependencies",
		"vsce:publish": "vsce publish --no-dependencies",
		"vscode:prepublish": "bun run build"
	},
	"dependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/lang-markdown": "^6.3.2",
		"@codemirror/language": "^6.11.1",
		"@codemirror/language-data": "^6.5.1",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.1",
		"mathjax-full": "^3.2.2",
		"mermaid": "^11.16.0",
		"prettier": "^3.8.3",
		"shiki": "^4.2.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@repo/vscode-utils": "workspace:*",
		"@tailwindcss/cli": "^4.3.3",
		"@types/vscode": "^1.100.0",
		"@vscode/codicons": "^0.0.45",
		"@vscode/vsce": "^3.7.1",
		"bun-types": "latest",
		"daisyui": "^5.6.18",
		"esbuild": "^0.27.2",
		"playwright-core": "^1.61.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.21.0"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Formatters",
		"Visualization",
		"Other"
	],
	"keywords": [
		"markdown",
		"wysiwyg",
		"live preview",
		"editor",
		"obsidian",
		"callouts",
		"tables",
		"math",
		"mermaid",
		"notes"
	],
	"activationEvents": [],
	"contributes": {
		"walkthroughs": [
			{
				"id": "marksmith.gettingStarted",
				"title": "Get Started with Marksmith",
				"description": "A live markdown editor that treats your notes like a craft.",
				"steps": [
					{
						"id": "playground",
						"title": "Open the playground",
						"description": "Marksmith renders markdown live and in place — tables, callouts, math, and diagrams, all editable. Open the playground to try it hands-on.\n[Open Playground](command:marksmith.openPlayground)",
						"media": {
							"markdown": "assets/walkthrough/playground.md"
						},
						"completionEvents": [
							"onCommand:marksmith.openPlayground"
						]
					},
					{
						"id": "editing",
						"title": "It's your markdown editor now",
						"description": "Marksmith is the default editor for every `.md` file — just open one. Toggle to raw text anytime with ⌘⇧M (Ctrl+Shift+M).",
						"media": {
							"markdown": "assets/walkthrough/editing.md"
						}
					}
				]
			}
		],
		"commands": [
			{
				"command": "marksmith.toggle",
				"title": "Toggle Raw/Preview",
				"category": "Marksmith",
				"icon": "$(book)"
			},
			{
				"command": "marksmith.insertCodeBlock",
				"title": "Insert Code Block",
				"category": "Marksmith"
			},
			{
				"command": "marksmith.insertCallout",
				"title": "Insert Callout",
				"category": "Marksmith"
			},
			{
				"command": "marksmith.insertMermaid",
				"title": "Insert Mermaid Diagram",
				"category": "Marksmith"
			},
			{
				"command": "marksmith.openPlayground",
				"title": "Open Playground",
				"category": "Marksmith",
				"icon": "$(rocket)"
			}
		],
		"keybindings": [
			{
				"command": "marksmith.toggle",
				"key": "ctrl+shift+m",
				"mac": "cmd+shift+m",
				"when": "resourceExtname == .md"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "marksmith.toggle",
					"group": "navigation",
					"when": "resourceExtname == .md"
				}
			],
			"commandPalette": [
				{
					"command": "marksmith.insertCodeBlock",
					"when": "resourceExtname == .md"
				},
				{
					"command": "marksmith.insertCallout",
					"when": "resourceExtname == .md"
				},
				{
					"command": "marksmith.insertMermaid",
					"when": "resourceExtname == .md"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "marksmith.editor",
				"displayName": "Marksmith",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "default"
			}
		],
		"configuration": {
			"title": "Marksmith",
			"properties": {
				"marksmith.mermaidRenderMode": {
					"default": "inline",
					"markdownDescription": "How Mermaid diagrams are rendered. `inline` replaces the code block with the diagram, `below` shows the diagram beneath the source, `disabled` leaves the code block as-is.",
					"enumDescriptions": [
						"Replace the code block with the rendered diagram",
						"Show the diagram below the source",
						"Leave the code block as-is"
					],
					"scope": "window",
					"type": "string",
					"enum": [
						"inline",
						"below",
						"disabled"
					]
				},
				"marksmith.callouts": {
					"default": {},
					"markdownDescription": "Override callout icons/colors or add custom types. Each entry is `{ \"icon\"?: …, \"color\"?: … }`. An `icon` can be an emoji, a `$(codicon)` name (e.g. `$(bell)`), or a raw `<svg>`. Omit `icon` to keep the built-in and only change the color. A `\"default\"` entry sets the fallback icon for any unlisted type.",
