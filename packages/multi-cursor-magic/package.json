{
	"name": "multi-cursor-magic",
	"displayName": "Multi-Cursor Magic",
	"description": "Multi-Cursor Magic VSCode Extension",
	"version": "0.0.4",
	"publisher": "trenaryja",
	"license": "MIT",
	"icon": "images/icon.png",
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"scripts": {
		"build": "bunx tsx ./scripts/build.ts",
		"build:analyze": "bunx tsx ./scripts/build.ts --analyze",
		"dev": "bunx tsx ./scripts/build.ts --watch",
		"fix": "eslint --fix . && prettier -w .",
		"check": "tsc && bun run lint && bun run build",
		"lint": "eslint . --max-warnings 0",
		"contribute-commands": "bunx tsx ./scripts/contribute-commands.ts",
		"vsce:login": "vsce login trenaryja",
		"vsce:package": "vsce package --no-dependencies --allow-missing-repository",
		"vsce:publish": "vsce publish --no-dependencies --allow-missing-repository",
		"vscode:prepublish": "bun run build"
	},
	"dependencies": {
		"@trenaryja/ui": "0.0.1-31",
		"chroma-js": "^3.2.0",
		"date-fns": "^4.1.0",
		"remeda": "^2.32.0"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@repo/vscode-utils": "workspace:*",
		"@types/chroma-js": "^3.1.2",
		"@types/module-alias": "^2.0.4",
		"@types/vscode": "^1.107.0",
		"@vscode/vsce": "^3.7.1",
		"bun-types": "^1.3.14",
		"esbuild": "^0.27.2",
		"eslint": "^9.39.2",
		"module-alias": "^2.2.3"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"engines": {
		"vscode": "^1.107.0"
	},
	"categories": [
		"Formatters",
		"Other"
	],
	"keywords": [
		"multi-cursor",
		"formatting",
		"transform",
		"dates",
		"numbers",
		"states",
		"countries",
		"eval",
		"productivity"
	],
	"changelog": true,
	"contributes": {
		"commands": [
			{
				"title": "Multi-Cursor Magic: Format Months",
				"command": "multiCursorMagic.formatMonths"
			},
			{
				"title": "Multi-Cursor Magic: Format Days of Week",
				"command": "multiCursorMagic.formatDaysOfWeek"
			},
			{
				"title": "Multi-Cursor Magic: Format US States",
				"command": "multiCursorMagic.formatUsStates"
			},
			{
				"title": "Multi-Cursor Magic: Format Countries",
				"command": "multiCursorMagic.formatCountries"
			},
			{
				"title": "Multi-Cursor Magic: Format Numbers",
				"command": "multiCursorMagic.formatNumbers"
			},
			{
				"title": "Multi-Cursor Magic: Eval",
				"command": "multiCursorMagic.evalDirect"
			},
			{
				"title": "Multi-Cursor Magic: Pad Start",
				"command": "multiCursorMagic.padStart"
			},
			{
				"title": "Multi-Cursor Magic: Format Colors",
				"command": "multiCursorMagic.formatColors"
			}
		]
	}
}
