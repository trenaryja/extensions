{
  "name": "multi-cursor-magic",
  "displayName": "Multi Cursor Magic",
  "description": "Multi Cursor Magic VSCode Extension",
  "version": "0.0.1",
  "publisher": "trenaryja",
  "license": "MIT",
  "icon": "images/icon.png",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p ./",
    "dev": "tsc -watch -p ./",
    "lint": "eslint . --max-warnings 0",
    "contribute-commands": "pnpm dlx tsx ./scripts/contribute-commands.ts",
    "vsce:login": "vsce login trenaryja",
    "vsce:package": "vsce package",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish": "vsce publish",
    "publish:patch": "pnpm version patch && vsce publish",
    "publish:minor": "pnpm version minor && vsce publish",
    "publish:major": "pnpm version major && vsce publish",
    "vscode:prepublish": "pnpm build"
  },
  "dependencies": {
    "country-state-city": "^3.2.1",
    "date-fns": "^4.1.0",
    "remeda": "^2.21.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.3.2",
    "@repo/config": "workspace:*",
    "@types/module-alias": "^2.0.4",
    "@types/vscode": "^1.73.0",
    "eslint": "^9.23.0",
    "module-alias": "^2.2.3"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "multi-cursor",
    "formatting",
    "transform",
    "dates",
    "numbers",
    "states",
    "countries",
    "eval",
    "productivity"
  ],
  "contributes": {
    "commands": [
      {
        "title": "Multi-Cursor Magic: Format Months",
        "command": "multiCursorMagic.formatMonths"
      },
      {
        "title": "Multi-Cursor Magic: Format Days of Week",
        "command": "multiCursorMagic.formatDaysOfWeek"
      },
      {
        "title": "Multi-Cursor Magic: Format US States",
        "command": "multiCursorMagic.formatUsStates"
      },
      {
        "title": "Multi-Cursor Magic: Format Countries",
        "command": "multiCursorMagic.formatCountries"
      },
      {
        "title": "Multi-Cursor Magic: Format Numbers",
        "command": "multiCursorMagic.formatNumbers"
      },
      {
        "title": "Multi-Cursor Magic: Eval",
        "command": "multiCursorMagic.evalDirect"
      },
      {
        "title": "Multi-Cursor Magic: Pad Start",
        "command": "multiCursorMagic.padStart"
      }
    ]
  }
}
