{
	"name": "multi-cursor-magic",
	"displayName": "Multi-Cursor Magic",
	"version": "0.0.4",
	"description": "Multi-Cursor Magic VSCode Extension",
	"categories": [
		"Formatters",
		"Other"
	],
	"keywords": [
		"multi-cursor",
		"formatting",
		"transform",
		"dates",
		"numbers",
		"states",
		"countries",
		"eval",
		"productivity"
	],
	"homepage": "https://github.com/trenaryja/extensions/tree/main/packages/multi-cursor-magic",
	"bugs": {
		"url": "https://github.com/trenaryja/extensions/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/trenaryja/extensions.git",
		"directory": "packages/multi-cursor-magic"
	},
	"license": "MIT",
	"publisher": "trenaryja",
	"main": "./dist/extension.js",
	"browser": "./dist/web/extension.js",
	"scripts": {
		"build": "bun ./scripts/build.ts",
		"build:analyze": "bun ./scripts/build.ts --analyze",
		"chk": "bun run contribute:check && tsc && prettier -c . && bunx eslint . --max-warnings=0",
		"contribute": "bun ./scripts/contribute.ts",
		"contribute:check": "bun ./scripts/contribute.ts --check",
		"dev": "bun ./scripts/build.ts --watch",
		"fix": "bun run contribute && prettier -w . && bunx eslint --fix .",
		"vsce:login": "vsce login trenaryja",
		"vsce:package": "bun run build && vsce package --no-dependencies",
		"vsce:publish": "bun run build && vsce publish --no-dependencies"
	},
	"contributes": {
		"commands": [
			{
				"command": "multiCursorMagic.formatMonths",
				"title": "Multi-Cursor Magic: Format Months"
			},
			{
				"command": "multiCursorMagic.formatDaysOfWeek",
				"title": "Multi-Cursor Magic: Format Days of Week"
			},
			{
				"command": "multiCursorMagic.formatUsStates",
				"title": "Multi-Cursor Magic: Format US States"
			},
			{
				"command": "multiCursorMagic.formatCountries",
				"title": "Multi-Cursor Magic: Format Countries"
			},
			{
				"command": "multiCursorMagic.formatNumbers",
				"title": "Multi-Cursor Magic: Format Numbers"
			},
			{
				"command": "multiCursorMagic.evalDirect",
				"title": "Multi-Cursor Magic: Eval"
			},
			{
				"command": "multiCursorMagic.padStart",
				"title": "Multi-Cursor Magic: Pad Start"
			},
			{
				"command": "multiCursorMagic.formatColors",
				"title": "Multi-Cursor Magic: Format Colors"
			}
		]
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"dependencies": {
		"@trenaryja/ui": "0.0.1-37",
		"chroma-js": "^3.2.0",
		"date-fns": "^4.4.0",
		"remeda": "^2.54.1"
	},
	"devDependencies": {
		"@repo/vscode-utils": "workspace:*",
		"@types/chroma-js": "^3.1.3",
		"@types/vscode": "^1.107.0",
		"@vscode/vsce": "^4.0.0"
	},
	"engines": {
		"vscode": "^1.107.0"
	},
	"icon": "images/icon.png",
	"changelog": true
}
